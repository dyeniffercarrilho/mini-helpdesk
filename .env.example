# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).

# Endereço do banco (na Neon: Connection string, com sslmode=require no final)
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Texto longo e aleatório. Para gerar um:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-um-texto-longo-e-aleatorio
